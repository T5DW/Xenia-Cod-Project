#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "BO1 Live - Black Ops Xbox Live server for Xenia"
      VALUE "ProductName", "BO1 Live"
      VALUE "FileVersion", "2.0"
      VALUE "ProductVersion", "2.0"
      VALUE "OriginalFilename", "bo1live.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
